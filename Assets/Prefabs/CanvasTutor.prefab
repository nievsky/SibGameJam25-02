  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TypeWritterEffect
  textUI: {fileID: 5535862729736096007}
  messages:
  - "\u0421\u043C\u0435\u043D\u0430 \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C,
    \u0442\u043E\u0432\u0430\u0440\u0438\u0449 \u0411\u0430\u0440\u043C\u0435\u043D."
  - "\u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u043E:
    \u043A\u0440\u0443\u0436\u043A\u0438 \u043F\u043E\u0441\u0435\u0442\u0438\u0442\u0435\u043B\u0435\u0439
    \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u043B\u043D\u044B"
  - "\u0422\u043E\u0433\u0434\u0430 \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A
    \u0434\u043E\u0432\u043E\u043B\u0435\u043D \u0438 \u043D\u0435 \u043F\u0430\u043B\u0438\u0442
    \u043D\u0430 \u0442\u0435\u0431\u044F."
  - "\u0410 \u043A\u043E\u0433\u0434\u0430 \u043E\u043D \u043D\u0435 \u043F\u0430\u043B\u0438\u0442,
    \u043C\u043E\u0436\u043D\u043E \u0437\u0430\u043D\u044F\u0442\u044C\u0441\u044F
    \u0441\u0430\u043C\u043E\u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435\u043C."
  - "\u0415\u0441\u043B\u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C,
    \u043E \u0447\u0451\u043C \u044F..."
  letterDelay: 0.05
  messageDelay: 2.5
  audioSource: {fileID: 0}
  typeSound: {fileID: 0}
  pitchVariation: 0.1

    - target: {fileID: 4415395097365761853, guid: 79ae827d03dd05c4898e374f7cd07e72, type: 3}
      propertyPath: 'messages.Array.data[2]'
      value: "\u041F\u0440\u0438\u0448\u043B\u043E \u043E\u0437\u0430\u0440\u0435\u043D\u0438\u0435:
        \u0432 \u0431\u0430\u0440\u0435 \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044B\u043B\u0438
        \u0442\u043E\u043B\u044C\u043A\u043E \u044F \u0438 \u043C\u043E\u044F \u0441\u043E\u0432\u0435\u0441\u0442\u044C."
      objectReference: {fileID: 0}
    - target: {fileID: 4415395097365761853, guid: 79ae827d03dd05c4898e374f7cd07e72, type: 3}
      propertyPath: 'messages.Array.data[3]'
      value: "\u042F \u043D\u0435 \u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0441\u044F
        \u0434\u043E \u0443\u0440\u043E\u0432\u043D\u044F \u044D\u0442\u0438\u0445
        \u043F\u044C\u044F\u043D\u044B\u0445 \u0432 \u0449\u0438 \u0430\u043B\u043A\u043E\u0433\u043E\u043B\u0438\u043A\u043E\u0432! "
      objectReference: {fileID: 0}
    - target: {fileID: 4415395097365761853, guid: 79ae827d03dd05c4898e374f7cd07e72, type: 3}
      propertyPath: 'messages.Array.data[4]'
      value: "(\u041A\u043E\u0442\u043E\u0440\u044B\u0445, \u043A\u0441\u0442\u0430\u0442\u0438,
        \u0441\u0430\u043C \u0436\u0435 \u0432\u044B\u0434\u0443\u043C\u0430\u043B.
        \u041D\u043E \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E!)"
      objectReference: {fileID: 0}
    - target: {fileID: 4415395097365761853, guid: 79ae827d03dd05c4898e374f7cd07e72, type: 3}
      propertyPath: 'messages.Array.data[5]'
      value: "\u041F\u043B\u043E\u0445\u0430\u044F \u043D\u043E\u0432\u043E\u0441\u0442\u044C:
        \u0437\u0430\u0432\u0442\u0440\u0430 \u0441\u043D\u043E\u0432\u0430 \u0441\u043C\u0435\u043D\u0430."
      objectReference: {fileID: 0}
    - target: {fileID: 4415395097365761853, guid: 79ae827d03dd05c4898e374f7cd07e72, type: 3}
      propertyPath: 'messages.Array.data[6]'
      value: "\u0418 \u043F\u043E\u0441\u043B\u0435\u0437\u0430\u0432\u0442\u0440\u0430.
        \u0418 \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0434\u0435\u043B\u044E.
        \u0418 \u0432\u0441\u0435\u0433\u0434\u0430."
      objectReference: {fileID: 0}
    - target: {fileID: 4415395097365761853, guid: 79ae827d03dd05c4898e374f7cd07e72, type: 3}
      propertyPath: 'messages.Array.data[7]'
      value: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
        \u0432 \u0431\u0430\u0440 \u201C\u041F\u044C\u044F\u043D\u044B\u0439 \u0432
        \u0429(\u0438)\u201D. "
      objectReference: {fileID: 0}
    - target: {fileID: 4415395097365761853, guid: 79ae827d03dd05c4898e374f7cd07e72, type: 3}
      propertyPath: 'messages.Array.data[8]'
      value: "\u0418\u0434\u0435\u0430\u043B\u044C\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E
        \u0434\u043B\u044F \u043C\u043E\u0440\u0430\u043B\u044C\u043D\u044B\u0445
        \u043F\u043E\u0431\u0435\u0434 \u043D\u0430\u0434 \u0441\u043E\u0431\u043E\u0439!"
      objectReference: {fileID: 0}
